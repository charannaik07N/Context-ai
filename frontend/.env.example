# Frontend dev proxy target for backend API
# Local backend default:
# VITE_API_PROXY_TARGET=http://localhost:8000

# Optional client key sent as X-Client-Key for server-bound namespace access
# VITE_CLIENT_KEY=web-client-key

# Optional ask timeout in milliseconds (backend LLM calls can exceed 60s)
# VITE_ASK_TIMEOUT_MS=180000

# Optional insights timeout in milliseconds (insights can take longer on local LLM)
# VITE_INSIGHTS_TIMEOUT_MS=240000

# Example staging backend:
# VITE_API_PROXY_TARGET=https://staging-api.example.com
